# Copy to .env for local dev (outside Docker) or set in docker-compose

NODE_ENV=development
SV_ENV=development

# PostgreSQL on shared_network (container: shared_postgres)
# Local dev (pnpm dev on host): use localhost:5432
DATABASE_URL=postgresql://platform:platform@localhost:5432/stock_verifier

# Redis on shared_network (container: shared_redis) — DB 1 reserved for Script Screener
# Local dev (pnpm dev on host): use localhost:6379
REDIS_URL=redis://localhost:6379/1

# JWT secrets — change in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Optional break-glass API key (parity with PHP SV_ADMIN_KEY)
# SV_ADMIN_KEY=

# API / Web ports (host mapping)
API_PORT=3100
WEB_PORT=5173

# CORS origin for React dev server
CORS_ORIGIN=http://localhost:5173

# NSE index CSV directory (admin sync + daily sync). Defaults to repo `data/indices`
# INDICES_DIR=/path/to/indices

# Default admin (seed) — only used on first db:seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# Trade signal email — entry/exit alerts (swing + intraday paper + morning exits)
# If SIGNAL_ALERT_EMAIL_TO is unset, uses the logged-in user's email from the DB.
SIGNAL_ALERT_EMAIL_TO=you@example.com
# Evening GTT digest email (16:00 IST). Set 0 to disable.
# EVENING_GTT_EMAIL=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Stock Verifier <you@example.com>

# Test SMTP: pnpm --filter @sv/data-adapters email:test
# Send live HC radar (needs snapshot): pnpm --filter @sv/data-adapters email:swing-radar

# Automatic swing radar emails (High Conviction hits after each Auto scan). Default: on when SMTP is set.
# Set to 0/false to disable. Recipients: SIGNAL_ALERT_EMAIL_TO, else users with Swing paper armed.
# SWING_RADAR_EMAIL=1

# Evening GTT digest email (16:00 IST from High Conviction). Default: on when SMTP is set.
# EVENING_GTT_EMAIL=0

# Open-book EXIT alert email (15:45 IST). Default: on when SMTP is set.
# EXIT_ALERT_EMAIL=0

# Optional webhook (Slack/Discord) for morning exit alerts
# MORNING_ALERT_WEBHOOK_URL=

# Optional webhook for Swing Auto High Conviction (HOT) tier additions.
# Falls back to MORNING_ALERT_WEBHOOK_URL when unset.
# SWING_RADAR_WEBHOOK_URL=
# Set to 0/false to disable. Default: on when a webhook URL is set.
# SWING_RADAR_WEBHOOK=1

# WhatsApp HOT alerts — see docs/WHATSAPP-ALERTS.md
# Recipient phone international format, e.g. 9198XXXXXXXX
# WHATSAPP_TO=9198XXXXXXXX
#
# Recommended: Twilio WhatsApp sandbox (easiest if CallMeBot API key fails)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# Option B — CallMeBot (personal; activation via WhatsApp chat, not a website form)
# WHATSAPP_CALLMEBOT_APIKEY=123456
#
# Option C — Meta WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0
#
# WHATSAPP_ALERTS=1
# Test: pnpm --filter @sv/data-adapters whatsapp:test

# M13: per-user rate limiting on heavy POST routes (screener, verify, swing scan)
# SV_RATE_LIMIT_WINDOW_SECONDS=60
# SV_RATE_LIMIT_MAX_PER_WINDOW=30

# M13: refresh token session TTL (days)
# SV_REFRESH_TOKEN_TTL_DAYS=30
